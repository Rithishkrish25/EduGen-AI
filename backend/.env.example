PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5432/edugen_ai
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT_MS=120000
JWT_SECRET=
JWT_EXPIRES_IN=1d
COOKIE_NAME=edugen_token
UPLOAD_DIR=uploads
MAX_FILE_SIZE_MB=20
OLLAMA_EMBED_MODEL=nomic-embed-text
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.25

# AI_PROVIDER controls which provider handles text generation (embeddings
# always stay on Ollama/nomic-embed-text - see OLLAMA_EMBED_MODEL above):
#   gemini -> Gemini only
#   ollama -> Ollama only
#   auto   -> Gemini primary, falls back to Ollama if Gemini is unavailable
AI_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_MS=30000
